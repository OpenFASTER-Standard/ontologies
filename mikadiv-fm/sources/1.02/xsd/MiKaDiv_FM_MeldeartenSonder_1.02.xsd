<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:fmmason="http://www.itzbund.de/MiKaDiv/FMMaSon/1.02"
  xmlns:fmmabase="http://www.itzbund.de/MiKaDiv/FMMaBase/1.02"
  xmlns:std="http://www.itzbund.de/MiKaDiv/FMStd/1.02"
  xmlns:fmfach="http://www.itzbund.de/MiKaDiv/FMFach/1.02" targetNamespace="http://www.itzbund.de/MiKaDiv/FMMaSon/1.02" elementFormDefault="qualified" attributeFormDefault="unqualified">
  <xs:import namespace="http://www.itzbund.de/MiKaDiv/FMStd/1.02" schemaLocation="./MiKaDiv_FM_Standardtypen_1.02.xsd"/>
  <xs:import namespace="http://www.itzbund.de/MiKaDiv/FMFach/1.02" schemaLocation="./MiKaDiv_FM_Fachtypen_1.02.xsd"/>
  <xs:import namespace="http://www.itzbund.de/MiKaDiv/FMMaBase/1.02" schemaLocation="./MiKaDiv_FM_MeldeartenBasis_1.02.xsd"/>
  <xs:complexType name="StornomeldungType">
    <xs:annotation>
      <xs:documentation>Stornierung einer irrtümlich abgegebenen Meldung.</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="fmmabase:MeldungType">
        <xs:attribute name="ErstmeldungUUID" type="std:UUIDType" use="required">
          <xs:annotation>
            <xs:documentation>Technische UUID der Erstmeldung, die storniert werden soll. Wenn eine ergänzende Steuerbescheinigung korrigiert/storniert wird, ist hier die UUID der zu korrigierenden/stornierenden ergänzenden Steuerbescheinigung einzutragen.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="Berichtigungsgrund" use="optional">
          <xs:annotation>
            <xs:documentation>Optionaler Berichtigungsgrund für die Stornierung.</xs:documentation>
          </xs:annotation>
          <xs:simpleType>
            <xs:restriction base="std:NameType">
              <xs:maxLength value="300"/>
              <xs:minLength value="1"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="Zeitstempel" type="xs:dateTime" use="required">
          <xs:annotation>
            <xs:documentation>Gibt den fachlichen Zeitpunkt an, auf den sich die Meldung bezieht / zu dem die Inhalte der Meldung fachlich wirksam geworden sind. Muss somit vor dem technischen Einlieferungszeitpunkt liegen. Meldungen werden an Hand des fachlichen Zeitstempels chronologisch sortiert.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="RefOrdnungsnummer" type="std:UUIDType" use="optional">
          <xs:annotation>
            <xs:documentation>Amtliche Ordnungsnummer der Steuerbescheinigung, auf die sich die Stornomeldung bezieht. Sollte die Stornomeldung sich auf eine Steuerbescheinigung mit amtlicher Ordnungsnummer beziehen, muss diese angegeben werden und mit der referenzierten Steuerbescheinigung übereinstimmen.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
    <!-- Hier muss noch irgendwie der Meldungstyp Storno mit rein! -->
  </xs:complexType>
  <!-- ZAM Meldung -->
  <xs:complexType name="ZusatzAngabenMeldung">
    <xs:annotation>
      <xs:documentation>Zusatzangaben für Meldearten, die nur Zu- und oder Abgänge umfassen.</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="fmmabase:MeldungType">
        <xs:sequence>
          <xs:element name="Zugaenge" type="fmfach:ZugangslisteType" minOccurs="0" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Angaben über angeschaffte Wertpapiere.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="Abgaenge" type="fmfach:AbgangslisteType" minOccurs="0" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Angaben über veräußerte Wertpapiere.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
</xs:schema>
